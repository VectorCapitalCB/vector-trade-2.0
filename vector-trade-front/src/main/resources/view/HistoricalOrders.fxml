<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.vc.blotter.controller.HistoricalOrdersController">
    <children>
        <VBox spacing="4" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="historical-orders-toolbar">
                <Label text="Cuenta"/>
                <ComboBox fx:id="accountFilter" prefWidth="150"/>
                <Label text="Desde"/>
                <DatePicker fx:id="fromDate" prefWidth="125"/>
                <Label text="Hasta"/>
                <DatePicker fx:id="toDate" prefWidth="125"/>
                <Label text="Instrumento"/>
                <TextField fx:id="symbolFilter" prefWidth="130" promptText="Todos"/>
                <Button fx:id="refreshButton" onAction="#refresh" text="Actualizar"
                        styleClass="historical-refresh-button"/>
                <Button fx:id="exportAllButton" onAction="#exportAll" text="Exportar Excel"
                        styleClass="historical-export-button">
                    <tooltip><Tooltip text="Exportar resumen, órdenes y todos sus palos según los filtros actuales"/></tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultLabel" text="Selecciona la pestaña para consultar"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" minHeight="126" prefHeight="126" spacing="10"
                  styleClass="historical-analytics-band">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                        <VBox alignment="CENTER" prefWidth="135" styleClass="historical-metric">
                            <Label text="Órdenes" styleClass="historical-metric-title"/>
                            <Label fx:id="ordersMetric" text="0" styleClass="historical-metric-value"/>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="135" styleClass="historical-metric">
                            <Label text="Palos" styleClass="historical-metric-title"/>
                            <Label fx:id="fillsMetric" text="0" styleClass="historical-metric-value"/>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="165" styleClass="historical-metric">
                            <Label text="Precio prom. compra" styleClass="historical-metric-title"/>
                            <Label fx:id="buyAveragePriceMetric" text="-" styleClass="historical-metric-value, metric-buy">
                                <tooltip><Tooltip text="Promedio ponderado por cantidad de los palos comprados en el filtro actual"/></tooltip>
                            </Label>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="165" styleClass="historical-metric">
                            <Label text="Precio prom. venta" styleClass="historical-metric-title"/>
                            <Label fx:id="sellAveragePriceMetric" text="-" styleClass="historical-metric-value, metric-sell">
                                <tooltip><Tooltip text="Promedio ponderado por cantidad de los palos vendidos en el filtro actual"/></tooltip>
                            </Label>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="180" styleClass="historical-metric">
                            <Label text="Monto compras" styleClass="historical-metric-title"/>
                            <Label fx:id="buyAmountMetric" text="0.00" styleClass="historical-metric-value, metric-buy"/>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="180" styleClass="historical-metric">
                            <Label text="Monto ventas" styleClass="historical-metric-title"/>
                            <Label fx:id="sellAmountMetric" text="0.00" styleClass="historical-metric-value, metric-sell"/>
                        </VBox>
                        <VBox alignment="CENTER" prefWidth="190" styleClass="historical-metric">
                            <Label text="P&amp;L realizado (rango)" styleClass="historical-metric-title"/>
                            <Label fx:id="realizedPnlMetric" text="0.00" styleClass="historical-metric-value"/>
                        </VBox>
                    </HBox>
                    <VBox alignment="CENTER" minWidth="390" prefWidth="390" styleClass="historical-chart-panel">
                        <Label fx:id="amountBySymbolTitle" text="Monto operado · Top 5 + Otros"
                               styleClass="historical-chart-title"/>
                        <HBox alignment="CENTER" spacing="6">
                            <PieChart fx:id="amountBySymbolChart" animated="false" labelsVisible="false"
                                      legendVisible="false" minHeight="100" prefHeight="100" prefWidth="210"/>
                            <VBox fx:id="amountBySymbolLegend" alignment="CENTER_LEFT" spacing="2"
                                  minWidth="155" prefWidth="155"/>
                        </HBox>
                    </VBox>
                </children>
            </HBox>

            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" styleClass="table-execution-style">
                <columns>
                    <TableColumn fx:id="dateColumn" minWidth="145" prefWidth="155" text="Última ejecución"/>
                    <TableColumn fx:id="sideColumn" minWidth="55" prefWidth="65" text="Tipo"/>
                    <TableColumn fx:id="symbolColumn" minWidth="95" prefWidth="120" text="Instrumento"/>
                    <TableColumn fx:id="accountColumn" minWidth="105" prefWidth="125" text="Cuenta"/>
                    <TableColumn fx:id="orderQtyColumn" minWidth="95" prefWidth="110" text="Cantidad orden"/>
                    <TableColumn fx:id="executedQtyColumn" minWidth="105" prefWidth="120" text="Cantidad ejecutada"/>
                    <TableColumn fx:id="avgPriceColumn" minWidth="95" prefWidth="110" text="Precio promedio"/>
                    <TableColumn fx:id="amountColumn" minWidth="115" prefWidth="140" text="Monto ejecutado"/>
                    <TableColumn fx:id="statusColumn" minWidth="75" prefWidth="90" text="Estado"/>
                    <TableColumn fx:id="fillsColumn" minWidth="55" prefWidth="65" text="Palos"/>
                    <TableColumn fx:id="orderIdColumn" minWidth="120" prefWidth="165" text="OrderID FIX"/>
                    <TableColumn fx:id="detailColumn" minWidth="78" prefWidth="88" text=""/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
