<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
           xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="cl.vc.blotter.controller.FooterController">

    <children>
        <ToolBar styleClass="footer-toolbar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <items>
                <Button fx:id="modo" styleClass="footer-action" minWidth="38.0" prefWidth="38.0" maxWidth="38.0" mnemonicParsing="false" onAction="#toggleDayNightMode"/>
                <Button fx:id="sound" styleClass="footer-action" onAction="#handleImageClick" text="Sonido"/>
                <Button fx:id="notifications" styleClass="footer-action" onAction="#handleImageNotification" text="Notificaciones"/>

                <Button fx:id="changePassword" styleClass="footer-action" onAction="#changePasswords" text="Configuraciones"/>
                <Button fx:id="btnNotification" styleClass="footer-action" onAction="#actionNotification" text="Consola"/>
                <Button fx:id="news" styleClass="footer-action" nodeOrientation="LEFT_TO_RIGHT" onAction="#readNews" text="Noticias"/>
                <Button fx:id="btnChat" styleClass="footer-action" onAction="#openChatView" text="Chat"/>
                <Button fx:id="btnConnections" styleClass="footer-action" onAction="#readConnections" text="Estado Conexión"/>
                <Button fx:id="btnMarketStats" styleClass="footer-action" onAction="#openMarketStats" visible="false" managed="false" text="Estadísticas"/>
                <Button fx:id="btnHistoricalOrders" styleClass="footer-action" onAction="#openHistoricalOrders" text="Órdenes Históricas"/>
                <Button fx:id="btnAdminUser" styleClass="footer-action" onAction="#btnAdminUser" text="Adm. Usuarios"
                        disable="true" visible="false" managed="false"/>
                <Region prefHeight="35.0" prefWidth="6.0"/>
                <HBox alignment="CENTER_LEFT" minHeight="28.0" prefHeight="28.0" maxHeight="28.0" spacing="0.0" styleClass="footer-fx-panel">
                    <children>
                        <Label alignment="CENTER" minWidth="30.0" prefWidth="30.0" maxWidth="30.0" prefHeight="26.0" styleClass="footer-fx-title" text="FX"/>
                        <Label id="lblBid" fx:id="lblBid" minWidth="50.0" prefWidth="50.0" prefHeight="26.0" styleClass="footer-fx-value,label-bid-green" text="0"/>
                        <Label id="lblAsk" fx:id="lblAsk" minWidth="50.0" prefWidth="50.0" prefHeight="26.0" styleClass="footer-fx-value,label-ask-red" text="0"/>
                        <Label id="lblLast" fx:id="lblLast" minWidth="50.0" prefWidth="50.0" prefHeight="26.0" styleClass="footer-fx-value,label-last" text="0"/>
                    </children>
                </HBox>
                <FontIcon iconLiteral="fth-user" iconSize="20" styleClass="footer-meta-icon,footer-user-icon"/>
                <Label fx:id="lbUser" styleClass="footer-user-label"/>
                <FontIcon fx:id="enviroment" iconLiteral="fth-shield" iconSize="20" styleClass="footer-meta-icon"/>
                <Label fx:id="lbEnviroment" prefHeight="18.0" styleClass="footer-environment-label"/>
                <Region minWidth="8.0" prefWidth="8.0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                <Button fx:id="reconnect" styleClass="footer-action" onAction="#reconnect" text="Reconectar"/>
            </items>
        </ToolBar>
    </children>
</AnchorPane>
