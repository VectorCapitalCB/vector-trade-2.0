<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.vc.blotter.controller.BalanceController">
    <center>
        <HBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
            <TitledPane fx:id="pane1" collapsible="false" maxHeight="Infinity" text="Saldo de cartera" HBox.hgrow="ALWAYS">
                <ScrollPane fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS">
                    <AnchorPane>
                        <VBox layoutX="5" layoutY="5" maxWidth="Infinity" spacing="12" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" VBox.vgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="balance-filter-bar" HBox.hgrow="ALWAYS">
                                <Label text="Cuenta" />
                                <TextField fx:id="accountFilter" minWidth="150" prefWidth="150" promptText="Filtra cuenta…" />
                                <Label text="Divisa" />
                                <ComboBox fx:id="divisaComboBox" minWidth="150" HBox.hgrow="ALWAYS" />
                                <HBox.margin>
                                    <Insets />
                                </HBox.margin>
                                <VBox.margin>
                                    <Insets />
                                </VBox.margin>
                            </HBox>
                            <HBox alignment="TOP_LEFT" fillHeight="true" maxWidth="Infinity" spacing="12"
                                  styleClass="balance-overview" HBox.hgrow="ALWAYS">
                                <VBox maxHeight="Infinity" maxWidth="Infinity" minWidth="280" spacing="8"
                                      styleClass="balance-section" HBox.hgrow="ALWAYS">
                                    <StackPane alignment="CENTER_LEFT">
                                        <Label styleClass="balance-section-title" text="Saldo" />
                                    </StackPane>
                                    <GridPane alignment="CENTER_LEFT" hgap="14" vgap="8"
                                              styleClass="balance-grid" GridPane.hgrow="ALWAYS">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="LEFT" minWidth="90" />
                                            <ColumnConstraints hgrow="ALWAYS" minWidth="140" />
                                        </columnConstraints>

                                        <Label styleClass="balance-field-label" text="Cuenta" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="cuentaField" editable="false" promptText="" styleClass="balance-readonly"
                                                   GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />

                                        <Label styleClass="balance-field-label" text="Cartera" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="carteraField" alignment="CENTER_RIGHT" editable="false" promptText="" styleClass="balance-readonly"
                                                   GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />

                                        <Label styleClass="balance-field-label" text="Cupo" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="cupoField" alignment="CENTER_RIGHT" editable="false" promptText="" styleClass="balance-readonly"
                                                   GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" />

                                        <Label styleClass="balance-field-label, balance-emphasis-label" text="Disponible" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <TextField fx:id="saldoDisponibleField" alignment="CENTER_RIGHT" editable="false" promptText=""
                                                   styleClass="balance-readonly, balance-available"
                                                   GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" />
                                    </GridPane>

                                    <VBox fx:id="garantiasSection" managed="false" maxWidth="Infinity"
                                          spacing="5" visible="false" VBox.vgrow="ALWAYS">
                                        <StackPane alignment="CENTER">
                                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="GARANTÍAS" />
                                        </StackPane>
                                        <Region minHeight="5" />
                                        <GridPane alignment="CENTER_LEFT" hgap="10" vgap="10" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="LEFT" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="120" />
                                            </columnConstraints>

                                            <Label style="-fx-padding: 0 0 0 15;" text="Garantías constituidas" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                            <TextField fx:id="garantiasConstituidasField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />

                                            <Label style="-fx-padding: 0 0 0 15;" text="Garantías exigidas" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                            <TextField fx:id="garantiasExigidasField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />

                                            <Label style="-fx-padding: 0 0 0 15;" text="Garantías reservadas" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                            <TextField fx:id="garantiasReservadasField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" />

                                            <Label style="-fx-padding: 0 0 0 15;" text="Límite financiero" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                            <TextField fx:id="limiteFinancieroField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" />

                                            <Label style="-fx-font-weight: bold; -fx-padding: 0 0 0 15;" text="Disponible" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                            <TextField fx:id="garantiasDisponibleField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" />
                                            <rowConstraints>
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                            </rowConstraints>
                                        </GridPane>
                                    </VBox>
                                </VBox>
                                <VBox maxHeight="Infinity" maxWidth="Infinity" minWidth="280" spacing="8"
                                      styleClass="balance-section" HBox.hgrow="ALWAYS">
                                    <StackPane alignment="CENTER_LEFT">
                                        <Label styleClass="balance-section-title" text="Actividad de órdenes" />
                                    </StackPane>
                                    <Label styleClass="balance-subsection-title" text="Activas" />
                                    <GridPane alignment="CENTER_LEFT" hgap="14" vgap="8"
                                              styleClass="balance-grid" GridPane.hgrow="ALWAYS">
                                        <columnConstraints>
                                            <ColumnConstraints halignment="LEFT" minWidth="90" />
                                            <ColumnConstraints hgrow="ALWAYS" minWidth="140" />
                                        </columnConstraints>

                                        <Label styleClass="balance-field-label" text="Compras" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="ordenesActivasComprasField" alignment="CENTER_RIGHT" editable="false" promptText=""
                                                   styleClass="balance-readonly" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />

                                        <Label styleClass="balance-field-label" text="Ventas" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="ordenesActivasVentasField" alignment="CENTER_RIGHT" editable="false" promptText=""
                                                   styleClass="balance-readonly" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
                                    </GridPane>

                                    <VBox maxWidth="Infinity" spacing="8">
                                        <Label styleClass="balance-subsection-title" text="Calzadas" />
                                        <GridPane alignment="CENTER_LEFT" hgap="14" vgap="8"
                                                  styleClass="balance-grid" GridPane.hgrow="ALWAYS">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="LEFT" minWidth="90" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="140" />
                                            </columnConstraints>

                                            <Label styleClass="balance-field-label" text="Compras" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                            <TextField fx:id="ordenesCalzadasComprasField" alignment="CENTER_RIGHT" editable="false" promptText=""
                                                       styleClass="balance-readonly" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />

                                            <Label styleClass="balance-field-label" text="Ventas" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                            <TextField fx:id="ordenesCalzadasVentasField" alignment="CENTER_RIGHT" editable="false" promptText=""
                                                       styleClass="balance-readonly" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
                                        </GridPane>
                                    </VBox>

                                    <VBox fx:id="ordenesCestaSection" managed="false" maxWidth="Infinity"
                                          spacing="10" visible="false" VBox.vgrow="ALWAYS">
                                        <StackPane alignment="CENTER">
                                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="ÓRDENES CESTA O ALGORITMOS" />
                                        </StackPane>
                                        <Region minHeight="0.0" prefHeight="0.0" prefWidth="241.0" />
                                        <GridPane alignment="CENTER_LEFT" hgap="10" vgap="10" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="LEFT" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="120" />
                                            </columnConstraints>

                                            <Label style="-fx-padding: 0 0 0 0;" text="Compras" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                            <TextField fx:id="ordenesCestaComprasField" editable="false" prefHeight="25.0" prefWidth="198.0" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />

                                            <Label style="-fx-padding: 0 0 0 0;" text="Ventas" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                            <TextField fx:id="ordenesCestaVentasField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />

                                            <Label style="-fx-padding: 0 0 0 0;" text="Rendimiento" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                            <TextField fx:id="rendimientoField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" />

                                            <Label style="-fx-font-weight: bold; -fx-padding: 0 0 0 0;" text="Total" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                            <TextField fx:id="totalField" editable="false" promptText="" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" />
                                            <rowConstraints>
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                                <RowConstraints vgrow="ALWAYS" />
                                            </rowConstraints>
                                        </GridPane>
                                    </VBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </AnchorPane>
                </ScrollPane>
            </TitledPane>
            <TitledPane fx:id="pane2" collapsible="false" maxHeight="Infinity" text="Patrimonio" HBox.hgrow="ALWAYS">
                <ScrollPane fitToHeight="true" fitToWidth="true" HBox.hgrow="ALWAYS">
                    <AnchorPane prefHeight="460.0" prefWidth="800.0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                        <VBox layoutX="5" layoutY="5" maxWidth="Infinity" spacing="10" VBox.vgrow="ALWAYS">
                            <TreeTableView fx:id="patrimonioTreeTableView" prefHeight="449.0" prefWidth="627.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TreeTableColumn fx:id="descripcionColumn" prefWidth="345" text="Descripción" />
                                    <TreeTableColumn fx:id="porcentajeColumn" prefWidth="100" text="Porcentaje" />
                                    <TreeTableColumn fx:id="montoColumn" prefWidth="180" text="Monto" />
                                </columns>
                            </TreeTableView>
                        </VBox>
                    </AnchorPane>
                </ScrollPane>
            </TitledPane>

        </HBox>
    </center>
</BorderPane>
